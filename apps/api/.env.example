DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
PORT=3002
CORS_ORIGIN="https://seu-frontend.sslip.io"

DRIVE_FOLDER_ID="cole_o_id_da_pasta_do_drive"

# OAuth — NÃO copie os valores abaixo; use os reais do Google Cloud / .secrets
# (este arquivo é só modelo para o Git)
